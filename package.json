{
  "name": "centinela-digital",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --use-env-proxy node_modules/next/dist/bin/next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node --use-env-proxy node_modules/next/dist/bin/next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:unit": "tsx --test tests/security.test.ts tests/database.test.ts tests/origin.test.ts tests/auth.test.ts",
    "check:config": "node --use-env-proxy scripts/check-config.mjs",
    "format": "prettier --write app components lib scripts tests supabase next.config.ts proxy.ts playwright.config.ts README.md package.json tsconfig.json postcss.config.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
