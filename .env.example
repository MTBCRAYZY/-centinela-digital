# Local fictitious demonstration. Set false for Supabase; never deploy demo publicly.
DEMO_MODE=true
# Generate: openssl rand -hex 32
SESSION_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
# Must equal your application's origin. Required outside development.
APP_ORIGIN=http://localhost:3000
# Opt in for each deployment. Production is enabled by the operating team.
ACCEPT_REAL_REPORTS=false
# Optional scanner for PDF support. JPG/PNG are decoded and rebuilt on the server.
EVIDENCE_SCANNER_URL=
